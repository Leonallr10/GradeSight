# Hugging Face Inference — vision model for extraction + optional bbox repair
# Used when LOCAL_EXTRACT_URL is unset (Vercel / deploy mode).
# Default works on most HF accounts. Qwen2.5-VL needs Hyperbolic (etc.) enabled.
HF_TOKEN=hf_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
HF_QWEN_MODEL=meta-llama/Llama-4-Scout-17B-16E-Instruct

# Optional: local fine-tuned extract server (ml/serve_extract.py)
# When set, /api/extract uses this instead of HF (no cascading fallback).
# LOCAL_EXTRACT_URL=http://127.0.0.1:8001

# Groq — grading + overall feedback (text only)
# Use a model listed in https://console.groq.com/docs/models for your account
GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
GROQ_MODEL=openai/gpt-oss-20b

# Recheck / eval
# RECHECK_BASE=http://localhost:3000
# RECHECK_USE_CACHE=1
# EVAL_STRICT=1
