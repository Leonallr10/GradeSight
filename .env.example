# Hugging Face Inference — vision model for ALL extraction (questions + answers)
# Default works on most HF accounts. Qwen2.5-VL needs Hyperbolic (etc.) enabled.
HF_TOKEN=hf_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
HF_QWEN_MODEL=meta-llama/Llama-4-Scout-17B-16E-Instruct

# Groq — grading + overall feedback (text only)
# Use a model listed in https://console.groq.com/docs/models for your account
GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
GROQ_MODEL=openai/gpt-oss-20b

# Optional: Gemini only for bbox repair + embeddings (not used for extract/grade)
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash-lite
